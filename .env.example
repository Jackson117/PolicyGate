# Copy to .env and fill in. Never commit the real file.

# The model provider, OpenAI-compatible. Both the agent and the user simulator
# use it; the NL-assertion judge does too. OPENAI_API_BASE is only needed when
# routing through a gateway rather than api.openai.com.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# The audit database, read by policygate.service.api. Defaults to
# sqlite:///audit.db when unset. MUST NOT be tau2's world-state database:
# scoring compares that one by hash, so one extra byte fails every task.
POLICYGATE_AUDIT_URL=postgresql+psycopg://policygate:policygate@localhost:5432/audit

# LangGraph checkpoints -- the paused sessions waiting on a human approval.
# Unset means in-memory, which loses a pending approval on restart.
POLICYGATE_CHECKPOINT_URL=postgresql://policygate:policygate@localhost:5432/audit

# Which run directory the dashboard opens by default, and where it looks for
# the others. Both optional.
POLICYGATE_RUN_DIR=experiments/w4_v4
POLICYGATE_RUN_ROOT=experiments

# --- the public deployment (see deploy/lightsail/) ------------------------
# Unset locally: a password on a dashboard that reads local files and talks to
# localhost protects nothing. Set it wherever the dashboard has a public URL.
POLICYGATE_DASHBOARD_PASSWORD=

# What one live session may spend on the model before the service stops taking
# turns. Unset means no limit, which is wrong anywhere a stranger can click.
POLICYGATE_SESSION_USD_CAP=0.25

# How many runs the dashboard holds in memory at once. The cache is per server
# process and shared by everyone connected, and w4_v4_ablation alone parses to
# about 1 GB; use 1 on a small box.
POLICYGATE_RUN_CACHE=2

# Where the dashboard's Live session page finds the service.
POLICYGATE_SERVICE_URL=http://localhost:8000
