# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
.env.local

# OS
.DS_Store

# Experiment outputs. Keep the config that produced a run and the derived
# metrics; keep raw traces out -- one retail results.json is ~7MB and every
# ablation cell produces another.
experiments/**/raw/
experiments/**/results*.json
experiments/**/sessions.jsonl
experiments/**/figures/*.png

# Vendored benchmark (pinned separately, see third_party/PIN.md)
third_party/tau2-bench/

# Per-run driver logs: raw and large (0.8-5 MB each), same reason as the traces
# above. What a run has to prove about itself is in its plan.json and ledger.json.
experiments/**/run.log

# The service's local audit store. The committed evidence is under experiments/;
# this is whatever the last `make service` happened to record.
audit.db

# Editor/agent workspace config
.claude/

# Project brief for Claude Code: local working notes, not part of the published
# project. Kept out of git deliberately.
CLAUDE.md
deploy/stage/
